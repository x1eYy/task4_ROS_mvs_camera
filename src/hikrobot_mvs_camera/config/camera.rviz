Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera Image
      Topic:
        Value: /image_raw
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
  Global Options:
    Fixed Frame: camera_optical_frame
    Frame Rate: 30
  Name: root
  Tools: []
